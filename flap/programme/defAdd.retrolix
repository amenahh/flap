def add_eight_intt(x,y)
    %rax <- copy %rdi ;
    %rax <- add %rax , %rsi ;
    %rax <- add %rax , %rdx ;
    %rax <- add %rax , %rcx ;
    %rax <- add %rax , %r8 ;
    %rax <- add %rax , %r9 ;
    %rax <- add %rax , x ;
    %rax <- add %rax , y ;
    ret ;
end

globals(S)
    %rdi <- copy 1 ;
    %rsi <- copy 2 ;
    %rdx <- copy 3 ;
    %rcx <- copy 4 ;
    %r8 <- copy 5 ;
    %r9 <- copy 6 ;
    add_eight_intt(1000,900) ;
    S <- copy %rax ;
    %rdi <- copy S ;
    observe_int() ;
end